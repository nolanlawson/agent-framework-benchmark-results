---
import type { Card } from '../lib/pokedex';
import { dexNumber, humanize, spriteUrl } from '../lib/pokedex';
import TypeBadge from './TypeBadge.astro';

interface Props {
  cards: Card[];
}
const { cards } = Astro.props;
---

<ul class="card-grid">
  {
    cards.map((card) => (
      <li class="card">
        <a class="card-link" href={`/pokemon/${card.name}`}>
          <img src={spriteUrl(card.id)} alt="" width="96" height="96" loading="lazy" decoding="async" />
          <span class="card-number">{dexNumber(card.id)}</span>
          <span class="card-name">{humanize(card.name)}</span>
        </a>
        {card.types && card.types.length > 0 && (
          <span class="card-types">
            {card.types.map((t) => (
              <TypeBadge name={t.name} label={t.label} link={false} />
            ))}
          </span>
        )}
        {card.note && <span class="card-note">{card.note}</span>}
      </li>
    ))
  }
</ul>
