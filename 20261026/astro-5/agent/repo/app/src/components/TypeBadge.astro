---
interface Props {
  name: string;
  label: string;
  /** Render as a link to the type page (default) or as plain text. */
  link?: boolean;
}

const { name, label, link = true } = Astro.props;
const style = `--type-color: var(--type-${name})`;
---

{
  link ? (
    <a class="type-badge" href={`/types/${name}`} style={style}>
      {label}
    </a>
  ) : (
    <span class="type-badge" style={style}>
      {label}
    </span>
  )
}
