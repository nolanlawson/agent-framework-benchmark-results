---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import EvolutionNode from '../../components/EvolutionNode.astro';
import MovesTable, { type MoveRow } from '../../components/MovesTable.astro';
import NotFound from '../../components/NotFound.astro';
import { api, idFromUrl, mapAll, resourcePath } from '../../lib/api';
import {
  compareMethods,
  dexNumber,
  englishName,
  humanize,
  latestFlavorText,
  moveInfo,
  typeLabels as getTypeLabels,
} from '../../lib/pokedex';

const STAT_LABELS: Record<string, string> = {
  hp: 'HP',
  attack: 'Attack',
  defense: 'Defense',
  'special-attack': 'Sp. Atk',
  'special-defense': 'Sp. Def',
  speed: 'Speed',
};
const MAX_STAT = 255;

const species = await api(resourcePath('pokemon-species', Astro.params.name!));
const variety = species?.varieties?.find((v: any) => v.is_default) ?? species?.varieties?.[0];
const [pokemon, chain, typeLabels] = await Promise.all([
  variety ? api(resourcePath('pokemon', idFromUrl(variety.pokemon.url))) : null,
  species?.evolution_chain ? api(resourcePath('evolution-chain', idFromUrl(species.evolution_chain.url))) : null,
  getTypeLabels(),
]);
if (!species || !pokemon) Astro.response.status = 404;

let page: any = null;
if (species && pokemon) {
  const name = englishName(species.names, species.name);
  const genus = species.genera?.find((g: any) => g.language.name === 'en')?.genus;
  const artwork = pokemon.sprites?.other?.['official-artwork']?.front_default ?? pokemon.sprites?.front_default;

  const stats = (pokemon.stats ?? []).map((s: any) => ({
    label: STAT_LABELS[s.stat.name] ?? humanize(s.stat.name),
    value: s.base_stat as number,
  }));
  const total = stats.reduce((sum: number, s: { value: number }) => sum + s.value, 0);

  const abilities = [...(pokemon.abilities ?? [])].sort((a: any, b: any) => a.slot - b.slot);

  // Version groups in which the Pokémon learns moves, ordered by the group's `order`.
  const groupNames = [
    ...new Set<string>(
      (pokemon.moves ?? []).flatMap((m: any) => m.version_group_details.map((d: any) => d.version_group.name)),
    ),
  ];
  const groupRecords = await mapAll(groupNames, (g) => api(resourcePath('version-group', g)));
  const games = groupNames
    .map((g, i) => ({ name: g, label: humanize(g), order: groupRecords[i]?.order ?? Infinity }))
    .sort((a, b) => a.order - b.order);
  const requestedGame = Astro.url.searchParams.get('game');
  const game = games.find((g) => g.name === requestedGame)?.name ?? games.at(-1)?.name;

  // Moves learned in the selected game, grouped by learn method.
  const learned: { move: string; method: string; level: number }[] = [];
  for (const m of pokemon.moves ?? []) {
    for (const d of m.version_group_details) {
      if (d.version_group.name === game) {
        learned.push({ move: m.move.name, method: d.move_learn_method.name, level: d.level_learned_at });
      }
    }
  }
  const moveNames = [...new Set(learned.map((l) => l.move))];
  const moveRecords = await mapAll(moveNames, (m) => api(resourcePath('move', m)));
  const moves = new Map(moveNames.flatMap((m, i) => (moveRecords[i] ? [[m, moveInfo(moveRecords[i])]] : [])));

  const byMethod = new Map<string, MoveRow[]>();
  for (const l of learned) {
    const move = moves.get(l.move);
    if (!move) continue;
    if (!byMethod.has(l.method)) byMethod.set(l.method, []);
    byMethod.get(l.method)!.push({ level: l.level, move });
  }
  const tables = [...byMethod.entries()]
    .sort(([a], [b]) => compareMethods(a, b))
    .map(([method, rows]) => ({
      method,
      rows: rows.sort(
        (a, b) => (method === 'level-up' ? a.level - b.level : 0) || a.move.label.localeCompare(b.move.label),
      ),
    }));

  page = {
    name,
    genus,
    artwork,
    flavor: latestFlavorText(species.flavor_text_entries),
    types: [...(pokemon.types ?? [])].sort((a: any, b: any) => a.slot - b.slot).map((t: any) => t.type.name),
    height: `${(pokemon.height / 10).toFixed(1)} m`,
    weight: `${(pokemon.weight / 10).toFixed(1)} kg`,
    stats,
    total,
    abilities,
    games,
    game,
    tables,
    chain: chain?.chain ?? { species: { name: species.name }, evolves_to: [] },
  };
}
---

{
  page ? (
    <Layout title={page.name}>
      <div class="summary">
        <div class="artwork">
          {page.artwork && <img src={page.artwork} alt={page.name} width="475" height="475" />}
        </div>
        <div class="info">
          <p class="dex">{dexNumber(species.id)}</p>
          <h1>{page.name}</h1>
          {page.genus && <p class="genus">{page.genus}</p>}
          <div class="badges">
            {page.types.map((t: string) => (
              <TypeBadge name={t} label={typeLabels.get(t) ?? humanize(t)} />
            ))}
          </div>
          <dl class="measures">
            <div>
              <dt>Height</dt>
              <dd>{page.height}</dd>
            </div>
            <div>
              <dt>Weight</dt>
              <dd>{page.weight}</dd>
            </div>
          </dl>
          {page.flavor && <p class="flavor">{page.flavor}</p>}
        </div>
      </div>

      <Section id="stats" title="Base stats">
        <table class="stats">
          <tbody>
            {page.stats.map((s: { label: string; value: number }) => (
              <tr>
                <th scope="row">{s.label}</th>
                <td>{s.value}</td>
                <td class="bar-cell" aria-hidden="true">
                  <span class="bar">
                    <span style={`width: ${Math.min(100, (s.value / MAX_STAT) * 100).toFixed(1)}%`} />
                  </span>
                </td>
              </tr>
            ))}
            <tr class="total">
              <th scope="row">Total</th>
              <td>{page.total}</td>
              <td class="bar-cell" aria-hidden="true">
                <span class="bar">
                  <span style={`width: ${Math.min(100, (page.total / (MAX_STAT * 6)) * 100).toFixed(1)}%`} />
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </Section>

      <Section id="abilities" title="Abilities">
        <ul class="links">
          {page.abilities.map((a: any) => (
            <li>
              <a href={`/abilities/${a.ability.name}`}>{humanize(a.ability.name)}</a>
              {a.is_hidden && ' (hidden)'}
            </li>
          ))}
        </ul>
      </Section>

      <Section id="evolution" title="Evolution">
        <ul class="links evolution">
          <EvolutionNode link={page.chain} />
        </ul>
      </Section>

      <Section id="moves" title="Moves">
        {page.games.length > 0 ? (
          <>
            <div class="game-field">
              <label for="game">Game</label>
              <select id="game" name="game" data-game>
                {page.games.map((g: { name: string; label: string }) => (
                  <option value={g.name} selected={g.name === page.game}>
                    {g.label}
                  </option>
                ))}
              </select>
            </div>
            <div class="move-tables" data-move-tables>
              {page.tables.map((t: { method: string; rows: MoveRow[] }) => (
                <MovesTable method={t.method} rows={t.rows} typeLabels={typeLabels} />
              ))}
            </div>
          </>
        ) : (
          <p class="muted">This Pokémon doesn't learn any moves.</p>
        )}
      </Section>
    </Layout>
  ) : (
    <NotFound />
  )
}

<script>
  import { enhanceSortableTables } from '../../scripts/sortable';

  enhanceSortableTables(document);

  const select = document.querySelector<HTMLSelectElement>('[data-game]');
  let latest = 0;
  select?.addEventListener('change', async () => {
    const url = new URL(location.href);
    url.searchParams.set('game', select.value);
    history.replaceState(null, '', url);
    const request = ++latest;
    try {
      const res = await fetch(url.pathname + url.search);
      const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
      if (request !== latest) return;
      const fresh = doc.querySelector('[data-move-tables]');
      const current = document.querySelector('[data-move-tables]');
      if (fresh && current) current.replaceWith(document.importNode(fresh, true));
    } catch {
      if (request === latest) location.assign(url);
    }
  });
</script>

<style>
  .summary {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .summary {
      grid-template-columns: var(--artwork-size) 1fr;
    }
  }

  .artwork {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    width: 100%;
    max-width: var(--artwork-size);
    margin-inline: auto;
    aspect-ratio: 1;
  }

  .artwork img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding-top: var(--space-4);
  }

  .dex,
  .genus {
    color: var(--color-text-muted);
  }

  .dex {
    margin-bottom: calc(-1 * var(--space-2));
  }

  .measures {
    display: flex;
    gap: var(--space-5);
    margin-top: var(--space-2);
  }

  .measures dt {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .flavor {
    margin-top: var(--space-2);
  }

  .stats {
    width: 100%;
    border-collapse: collapse;
  }

  .stats th,
  .stats td {
    padding: var(--space-1) 0;
    text-align: left;
    font-weight: var(--weight-normal);
  }

  .stats th {
    width: 6rem;
    font-size: var(--text-sm);
  }

  .stats td:not(.bar-cell) {
    width: 3rem;
  }

  .stats .total th,
  .stats .total td {
    padding-top: var(--space-3);
  }

  .bar {
    display: block;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-stat-track);
    overflow: hidden;
  }

  .bar > span {
    display: block;
    height: 100%;
    background: var(--color-stat-bar);
    border-radius: var(--radius-pill);
  }

  .links {
    margin: 0;
    padding-left: var(--space-5);
  }

  .evolution :global(ul) {
    padding-left: var(--space-5);
  }

  .game-field {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .game-field label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .game-field select {
    height: 2.5rem;
    min-width: 16rem;
    max-width: 100%;
    padding: 0 var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .move-tables {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
</style>
