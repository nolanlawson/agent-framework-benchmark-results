{
  "name": "pokedex",
  "description": "Pokédex built with Qwik City",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && vite build -c adapters/node-server/vite.config.ts",
    "build.types": "tsc --noEmit",
    "dev": "vite --mode ssr",
    "start": "node server/entry.node-server"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.3",
    "@builder.io/qwik-city": "1.20.3",
    "@types/node": "^24.0.0",
    "typescript": "5.4.5",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^4.2.1"
  }
}
