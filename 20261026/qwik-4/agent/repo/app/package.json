{
  "name": "pokedex-qwik",
  "description": "Pokédex built with Qwik City",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/node-server/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "lint": "eslint \"src/**/*.ts*\"",
    "start": "node server/entry.node-server",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.3",
    "@builder.io/qwik-city": "1.20.3",
    "@eslint/js": "^9",
    "@types/node": "20.19.0",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "1.20.3",
    "globals": "16.4.0",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^4.2.1"
  }
}
