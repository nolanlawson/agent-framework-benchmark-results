---
import Layout from '../../layouts/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import Section from '../../components/Section.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import CardList from '../../components/CardList.astro';
import { getMovePage } from '../../lib/api';

const data = await getMovePage(Astro.params.name ?? '');
if (!data) Astro.response.status = 404;
const dash = '—';
---

{!data && <NotFound />}
{
  data && (
    <Layout title={data.label}>
      <h1>{data.label}</h1>
      <dl class="panel facts facts--panel">
        <div>
          <dt>Type</dt>
          <dd>{data.type ? <TypeBadge name={data.type.name} label={data.type.label} link /> : dash}</dd>
        </div>
        <div>
          <dt>Category</dt>
          <dd>{data.category ?? dash}</dd>
        </div>
        <div>
          <dt>Power</dt>
          <dd>{data.power ?? dash}</dd>
        </div>
        <div>
          <dt>Accuracy</dt>
          <dd>{data.accuracy ?? dash}</dd>
        </div>
        <div>
          <dt>PP</dt>
          <dd>{data.pp ?? dash}</dd>
        </div>
      </dl>
      <Section id="effect" title="Effect">
        <p>{data.effect ?? dash}</p>
      </Section>
      <Section id="learned-by" title="Learned by">
        <p class="count">{data.learnedBy.length} Pokémon</p>
        <CardList items={data.learnedBy} />
      </Section>
    </Layout>
  )
}
