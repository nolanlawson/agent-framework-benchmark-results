---
import Layout from '../../layouts/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import Section from '../../components/Section.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import CardList from '../../components/CardList.astro';
import { getTypePage } from '../../lib/api';

const data = await getTypePage(Astro.params.name ?? '');
if (!data) Astro.response.status = 404;
---

{!data && <NotFound />}
{
  data && (
    <Layout title={data.label}>
      <h1>{data.label}</h1>
      <Section id="relations" title="Damage relations">
        <dl class="relations">
          {data.relations.map((r) => (
            <div>
              <dt>{r.label}</dt>
              <dd>
                {r.types.length === 0
                  ? 'None'
                  : r.types.map((t) => <TypeBadge name={t.name} label={t.label} link />)}
              </dd>
            </div>
          ))}
        </dl>
      </Section>
      <Section id="pokemon" title="Pokémon">
        <p class="count">{data.pokemon.length} Pokémon</p>
        <CardList items={data.pokemon} />
      </Section>
      <Section id="moves" title="Moves">
        <p class="count">{data.moves.length} moves</p>
        <ul class="link-columns" role="list">
          {data.moves.map((m) => (
            <li>
              <a href={`/moves/${m.name}`}>{m.label}</a>
            </li>
          ))}
        </ul>
      </Section>
    </Layout>
  )
}
